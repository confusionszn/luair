{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luair",
  "version": "2.0.2",
  "identifier": "com.luair.overlay",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "overlay",
        "url": "index.html?window=overlay",
        "title": "Luair Overlay",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": true,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding"
      },
      {
        "label": "menu",
        "url": "index.html?window=menu",
        "title": "Luair",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": true,
        "shadow": false,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Luair",
    "homepage": "https://github.com/confusionszn/luair",
    "copyright": "Copyright (c) 2026 Luair Contributors",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Independent high-performance desktop crosshair overlay",
    "longDescription": "Luair is an open-source, lightweight desktop crosshair overlay built with Rust and Tauri v2, featuring OBS/Discord capture cloaking, non-blocking global hotkeys, dynamic themes, local encrypted accounts, and embedded Candle GGUF AI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libx11-6",
          "libxtst6",
          "libssl3"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "libX11",
          "libXtst",
          "openssl-libs"
        ],
        "release": "1",
        "compression": {
          "type": "zstd",
          "level": 6
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNUJBNkFEM0M3MEUyQ0YKUldUUDRuQThyYVpiMEhETnZ3cnhkWnBqc21vTzBQcWw4akNaOXNoTlB5dnk1azE4V3d6Q2p6ZUkK",
      "endpoints": [
        "https://github.com/confusionszn/luair/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
